{
  "model": "Gemini 3.8 Flash (Medium)",
  "toolPermission": "always-proceed",
  "enableTerminalSandbox": true,
  "allowNonWorkspaceAccess": true,
  "disableSlashCommands": true,
  "permissions": {
    "allow": [
      "command(docker ps)",
      "command(docker logs)",
      "command(docker stats)",
      "command(docker info)",
      "command(docker version)",
      "command(docker images)",
      "command(docker compose)",
      "command(colima status)",
      "command(colima list)",
      "command(git status)",
      "command(git log)",
      "command(git diff)",
      "command(git branch)",
      "command(git show)",
      "command(git remote)",
      "command(df)",
      "command(du)",
      "command(uptime)",
      "command(vm_stat)",
      "command(top -l)",
      "command(ps)",
      "command(sysctl)",
      "command(uname)",
      "command(sw_vers)",
      "command(arch)",
      "command(hostname)",
      "command(date)",
      "command(whoami)",
      "command(id)",
      "command(diskutil list)",
      "command(diskutil info)",
      "command(pmset -g)",
      "command(system_profiler)",
      "command(lsof)",
      "command(netstat)",
      "command(ifconfig)",
      "command(scutil)",
      "command(ping -c)",
      "command(brew list)",
      "command(brew info)",
      "command(brew services list)",
      "command(ls)",
      "command(stat)",
      "command(file)",
      "command(wc)",
      "command(sort)",
      "command(uniq)",
      "command(head)",
      "command(tail)",
      "command(grep)",
      "command(cut)",
      "command(tr)",
      "command(which)",
      "read_file(__HOME__/.config/imessage-agy-bridge/workspaces/jail)",
      "read_file(__HOME__/.local/share/imessage-agy-jail)",
      "read_file(/Volumes)",
      "read_file(/tmp)",
      "read_file(/private/tmp)",
      "read_file(/var/log)",
      "read_file(/private/var/log)"
    ],
    "deny": [
      "write_file(*)",
      "read_url(*)",
      "execute_url(*)",
      "mcp(*)",
      "read_file(__HOME__/.ssh)",
      "read_file(__HOME__/.gemini)",
      "read_file(__HOME__/.gnupg)",
      "read_file(__HOME__/.aws)",
      "read_file(__HOME__/.kube)",
      "read_file(__HOME__/.docker)",
      "read_file(__HOME__/.config/imessage-agy-bridge/.env)",
      "read_file(__HOME__/.config/imessage-agy-bridge/bridge_state.json)",
      "read_file(__HOME__/.netrc)",
      "read_file(__HOME__/.zsh_history)",
      "read_file(__HOME__/.bash_history)",
      "read_file(__HOME__/Library)",
      "read_file(__HOME__/Code/imessage-agy-bridge)",
      "command(cat)",
      "command(find)",
      "command(xargs)",
      "command(awk)",
      "command(sed)",
      "command(perl)",
      "command(python)",
      "command(python3)",
      "command(ruby)",
      "command(node)",
      "command(sh)",
      "command(bash)",
      "command(zsh)",
      "command(osascript)",
      "command(swift)",
      "command(curl)",
      "command(wget)",
      "command(ssh)",
      "command(scp)",
      "command(rsync)",
      "command(rm)",
      "command(mv)",
      "command(cp)",
      "command(dd)",
      "command(tee)",
      "command(kill)",
      "command(pkill)",
      "command(killall)",
      "command(shutdown)",
      "command(reboot)",
      "command(sudo)",
      "command(su)",
      "command(chmod)",
      "command(chown)",
      "command(launchctl)",
      "command(docker run)",
      "command(docker exec)",
      "command(docker rm)",
      "command(docker stop)",
      "command(docker kill)"
    ]
  },
  "trustedWorkspaces": [
    "__HOME__/.config/imessage-agy-bridge/workspaces/jail",
    "__HOME__/.local/share/imessage-agy-jail"
  ]
}
