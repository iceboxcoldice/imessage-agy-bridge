# ==============================================================================
# iMessage <-> Antigravity CLI (agy) Bridge Configuration
# Hot-reloaded automatically whenever this file is saved — NO rebuild or FDA toggle needed!
# ==============================================================================

# 1. Identity & Access Control
ADMIN_HANDLES="admin@example.com,+15550001111"
ALLOWED_SENDERS="admin@example.com,+15550001111,secondary@example.com,+15550002222"
ALLOWED_SERVICES="iMessage"
MAX_MESSAGE_AGE_SECONDS=300
MAX_REQUESTS_PER_MINUTE=10

# 2. Triggering & Built-in Chat Commands
TRIGGER_PREFIXES="@agy,!agy"
MIDSENTENCE_KEYWORDS="@agy"
REQUIRE_PREFIX=true
# Built-in daemon commands to reset/rotate conversation context (works even when CLI slash commands are disabled)
NEW_CHAT_COMMANDS="/new,/clear,/reset"

# 3. Paths, Isolated Workspaces & Settings Profiles
DB_PATH="~/Library/Messages/chat.db"
STATE_FILE="bridge_state.json"
APPROVAL_DIR="approvals"
AGY_BINARY="~/.local/bin/agy"
DISCLAIM_CHILD_TCC=true
CONVERSATION_ID="imessage-agy-main"

RESTRICTED_WORKSPACE_DIR="~/.config/imessage-agy-bridge/workspaces/jail"
ADMIN_WORKSPACE_DIR="~/.config/imessage-agy-bridge/workspaces/admin"
RESTRICTED_SETTINGS_FILE="~/.config/imessage-agy-bridge/workspaces/jail/bridge-settings.json"
ADMIN_SETTINGS_FILE="~/.config/imessage-agy-bridge/workspaces/admin/bridge-settings-admin.json"

# 4. Execution, Sandboxing, Models & Timeouts
# Optional per-tier model overrides (leave empty to use model in bridge-settings*.json)
AGY_MODEL_RESTRICTED=""
AGY_MODEL_ADMIN=""
RESTRICTED_SANDBOX=true
ADMIN_SANDBOX=false
DISABLE_SLASH_COMMANDS=true
AGY_PRINT_TIMEOUT="5m"
AGY_TASK_TIMEOUT_SECONDS=120
OSASCRIPT_TIMEOUT_SECONDS=15
MAX_OUTPUT_BYTES=262144
MAX_LOG_BYTES=5242880

# 5. 1:1 Primary Admin Interactive Permission & Secret Policy
# Options for ADMIN_ASK_FOR_*: true (prompt YES/NO via iMessage), false (hard block)
ADMIN_ASK_FOR_DESTRUCTIVE=true
ADMIN_ASK_FOR_SECRETS=true
REQUIRE_APPROVAL_CODE=false
APPROVAL_TIMEOUT_SECONDS=90

REDACT_SECRETS_RESTRICTED=true
REDACT_SECRETS_ADMIN_UNLESS_APPROVED=true

# Optional comma-separated policy extensions (no recompile needed)
EXTRA_ALLOWED_COMMANDS=""
EXTRA_BLOCKED_PATHS=""
ALLOWED_READ_ROOTS=""

# 6. Polling, Deduplication & Reply Formatting
POLL_INTERVAL_SECONDS=2.0
DUPLICATE_WINDOW_SECONDS=45.0
SIMILARITY_THRESHOLD=0.80
MAX_REPLY_LENGTH=1800
SEND_ACK=true
ACK_TEXT="🤖 AGY is thinking..."
